<Window x:Class="DiscordVocalOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="DiscordVocalOverlay"
        Icon="app.ico"
        Width="500" Height="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Button Styles -->
            <Style x:Key="BaseButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#B9BBBE"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#404249"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="#5865F2"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="12,6"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#4752C4"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#3C45A5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="#ED4245"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="12,6"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#C93B3E"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#A83436"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#2B2D31"
            CornerRadius="12"
            BorderThickness="1"
            Effect="{DynamicResource SystemDropShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status Bar -->
            <Border Grid.Row="0" 
                    Background="#1E1F22"
                    Padding="12,4"
                    CornerRadius="12,12,0,0"
                    BorderThickness="0,0,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText"
                               Text="Ready to Record"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#5865F2"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimerText"
                               Text="00:00"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#B9BBBE"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Button Panel -->
            <Grid Grid.Row="1" Margin="8,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: State Icon + Audio Level Meter -->
                <StackPanel Grid.Column="0" 
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    
                    <!-- State Icon -->
                    <TextBlock x:Name="StateIcon"
                               Text="🎤"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    
                    <!-- Audio Level Meter (only visible during recording) -->
                    <Border x:Name="AudioLevelBorder"
                            Width="6"
                            Height="40"
                            Background="#1E1F22"
                            CornerRadius="3"
                            Margin="4,0,8,0"
                            VerticalAlignment="Center">
                        <Border x:Name="AudioLevelBar"
                                Width="6"
                                Height="4"
                                Background="#5865F2"
                                CornerRadius="2"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Center: Main Actions -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Record Button -->
                    <Button x:Name="RecordButton"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RecordToggleCommand}"
                            ToolTip="Start/Stop Recording">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" FontSize="10" Margin="0,0,4,0"/>
                            <TextBlock Text="Record"/>
                        </StackPanel>
                    </Button>

                    <!-- Play Button -->
                    <Button x:Name="PlayButton"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding PlayToggleCommand}"
                            ToolTip="Play/Stop Audio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PlayButtonIcon" Text="▶" FontSize="10" Margin="0,0,4,0"/>
                            <TextBlock x:Name="PlayButtonText" Text="Play" FontSize="11" Margin="0,0,4,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Delete Button -->
                    <Button x:Name="DeleteButton"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding DeleteCommand}"
                            ToolTip="Delete Recording">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Delete"/>
                        </StackPanel>
                    </Button>

                    <!-- Back Button -->
                    <Button x:Name="BackButton"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding BackToIdleCommand}"
                            ToolTip="Back to Record">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◀" FontSize="10" Margin="0,0,4,0"/>
                            <TextBlock Text="Back"/>
                        </StackPanel>
                    </Button>

                    <!-- Copy Button (visible only when recording is ready) -->
                    <Button x:Name="CopyButton"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding CopyFileCommand}"
                            ToolTip="Copy file to clipboard"
                            Padding="8,4"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="Copy"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Utility Buttons -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- Settings Button -->
                    <Button Style="{StaticResource BaseButton}"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip="Settings"
                            Padding="6,4">
                        <TextBlock Text="⚙" FontSize="14"/>
                    </Button>

                    <!-- Device Selection Button -->
                    <Button Style="{StaticResource BaseButton}"
                            Command="{Binding ShowDeviceSelectionCommand}"
                            ToolTip="Select Microphone"
                            Padding="6,4">
                        <TextBlock Text="🎙" FontSize="14"/>
                    </Button>

                    <!-- Folder Button -->
                    <Button Style="{StaticResource BaseButton}"
                            Command="{Binding OpenFolderCommand}"
                            ToolTip="Open Recordings Folder"
                            Padding="6,4">
                        <TextBlock Text="📂" FontSize="14"/>
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="CloseButton"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding CloseCommand}"
                            ToolTip="Close"
                            Padding="6,4">
                        <TextBlock Text="✕" FontSize="12" Foreground="#ED4245"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
